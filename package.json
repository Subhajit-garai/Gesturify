{
  "name": "gesturify-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@gesturify/web",
    "dev:docs": "turbo dev --filter=@gesturify/docs",
    "dev:admin": "turbo dev --filter=@gesturify/admin",
    "build": "turbo build",
    "build:web": "turbo build --filter=@gesturify/web",
    "build:docs": "turbo build --filter=@gesturify/docs",
    "build:admin": "turbo build --filter=@gesturify/admin",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@10.24.0"
}
