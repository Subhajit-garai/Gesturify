{
  "name": "gesturify-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:all": "turbo dev",
    "dev:docs": "npm --prefix apps/docs run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "build:all": "turbo build",
    "lint": "npm --prefix apps/web run lint",
    "users": "node scripts/count-users.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.4"
  },
  "packageManager": "pnpm@10.24.0",
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "@neon/config": "^1.8.1",
    "@neon/env": "^1.4.6",
    "@neondatabase/serverless": "^1.1.0"
  }
}
